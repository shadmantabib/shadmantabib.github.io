<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign work = data[1] | sort: 'startDate' | reverse %}
  {% for content in work %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-12">
          {% if content.startDate %}
            {% assign startDate = content.startDate | split: '-' | slice: 0, 2 | join: '.' %}
            {% assign endDate = content.endDate | split: '-' | slice: 0, 2 | join: '.' | default: 'Present' %}
            {% assign date = startDate | append: ' - ' %}
            {% assign date = date | append: endDate %}
            <div class="mb-3" style="clear: both;">
              <span class="badge badge-pill font-weight-bold danger-color-dark text-uppercase" style="font-size: 0.7rem; padding: 0.25em 0.5em; display: block; width: fit-content; max-width: 150px;">{{ date }}</span>
            </div>
          {% endif %}
          <div style="clear: both; margin-top: 8px;">
            <h6 class="title font-weight-bold mb-1">
              <a href="{{ content.url }}">{{ content.position }}</a>
            </h6>
          </div>
          {% if content.location %}
            <p class="location text-muted mb-2" style="font-size: 0.9rem;">
              <i class="fa-solid fa-location-dot"></i>
              {{ content.location }}
            </p>
          {% endif %}
          <h6 class="mb-1" style="font-size: 0.95rem; font-weight: 600;">{{ content.name }}</h6>
          <p class="text-muted mb-2" style="font-size: 0.9rem; font-style: italic;">{{ content.summary }}</p>
          <ul class="items">
            {% for item in content.highlights %}
              <li>
                <span class="item">{{ item }}</span>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
