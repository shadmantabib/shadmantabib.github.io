---
import type { Publication } from "../data/publications.ts";
interface Props {
  pub: Publication;
}
const { pub } = Astro.props;
---

<div class="pub">
  <div class="pub-abbr"><span>{pub.abbr}</span></div>
  <div class="pub-body">
    <h3 class="pub-title">{pub.title}</h3>
    <p class="pub-authors">
      {
        pub.authors.map((au, i) => (
          <>
            <span class={au.me ? "me" : ""}>
              {au.name}
              {au.coFirst ? "*" : ""}
            </span>
            {i < pub.authors.length - 1 ? ", " : ""}
          </>
        ))
      }
    </p>
    <p class="pub-venue">
      {pub.venue}, {pub.year}
      {pub.note && <span class="note">{pub.note}</span>}
    </p>
    {
      pub.links.length > 0 && (
        <div class="pub-links">
          {pub.links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener">
              {l.label}
            </a>
          ))}
        </div>
      )
    }
  </div>
</div>
