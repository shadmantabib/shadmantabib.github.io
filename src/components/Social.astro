---
import Icon from "./Icon.astro";
import { socials, contactNote } from "../data/socials.ts";
---

<div class="social">
  <div class="contact-icons">
    {
      socials.map((s) => (
        <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
          <Icon name={s.icon} />
        </a>
      ))
    }
  </div>
  <p class="contact-note">{contactNote}</p>
</div>
