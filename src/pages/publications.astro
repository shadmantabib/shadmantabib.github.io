---
import BaseLayout from "../layouts/BaseLayout.astro";
import PubEntry from "../components/PubEntry.astro";
import { publicationsByYear } from "../data/publications.ts";
const groups = publicationsByYear();
---

<BaseLayout title="Publications" description="Publications by H.M. Shadman Tabib in reverse chronological order.">
  <header class="page-header">
    <h1>Publications</h1>
    <p class="desc">
      Journal articles, conference papers, and preprints — newest first. 18 citations on Google
      Scholar.
    </p>
  </header>

  {
    groups.map((g) => (
      <section>
        <h2 class="pub-year">{g.year}</h2>
        {g.items.map((pub) => (
          <PubEntry pub={pub} />
        ))}
      </section>
    ))
  }
</BaseLayout>
