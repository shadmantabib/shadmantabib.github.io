---
import BaseLayout from "../layouts/BaseLayout.astro";

const research = [
  {
    name: "Contextualized Machine Learning Review",
    href: "https://github.com/shadmantabib/context-review",
    desc: "Comprehensive review on contextualized machine learning and interpretability in foundation models. Research collaboration with UW-Madison focusing on adaptive and generalizable AI systems.",
  },
  {
    name: "TomoPicker",
    href: "https://github.com/shadmantabib/TomoPicker",
    desc: "3D particle picking for cryo-electron tomography using computer vision and deep learning. Enables automated detection and localization of macromolecular structures in cellular environments.",
  },
];

const development = [
  {
    name: "CareSync",
    href: "https://github.com/shadmantabib/CareSync",
    demo: "https://youtu.be/WMaVmAf3Azg?si=62Ljz2p9o_Dj91Ez",
    desc: "Healthcare service platform for appointment booking and clinical workflow management. Built with React frontend and Spring Boot backend.",
  },
  {
    name: "Real-Time Incident Reporting App",
    href: "https://github.com/shadmantabib/info_db_test",
    demo: "https://youtu.be/AExJwaOTDvE?si=JBJYFS2IylM8eHpB",
    desc: "Lightweight information-management application demonstrating database-backed operations and API-driven workflows. Flutter frontend with FastAPI backend.",
  },
  {
    name: "Cricitup",
    href: "https://github.com/shadmantabib/CSE-216-DB_project_Cricitup",
    demo: "https://www.youtube.com/watch?v=1WTVka0U-xw",
    desc: "Database-driven web application emphasizing relational schema design, SQL queries, and CRUD operations. Built with Django and Bootstrap.",
  },
  {
    name: "Slowloris Attack Project",
    href: "https://github.com/shadmantabib/Slowloris_Attack_Project",
    demo: "https://youtu.be/dJ4E7xeyHE4?si=9v0a-g3ikhC0BXsW",
    desc: "Educational implementation of Slowloris-style DoS attack to study server resource exhaustion and defensive strategies in cybersecurity.",
  },
  {
    name: "Side-Channel Attack",
    href: "https://github.com/shadmantabib/CSE-406/tree/main/Offline_2_Side_Channel_Attack",
    desc: "Side-channel attack pipeline implemented for a security course assignment, focusing on threat modeling, leakage analysis, and reproducible experimentation.",
  },
];

const coursework = [
  {
    name: "BUET CSE Academic Compendium",
    href: "https://github.com/shadmantabib/BUET_CSE_Academic_Compendium",
    desc: "Comprehensive collection of undergraduate CS course materials and assignments at BUET, covering Data Structures, Algorithms, Databases, Operating Systems, Computer Networks, and more.",
  },
];
---

<BaseLayout
  title="Repositories"
  description="Curated collection of research projects and open-source contributions."
>
  <header class="page-header">
    <h1>Repositories</h1>
    <p class="desc">A curated collection of research code and open-source projects.</p>
  </header>

  <h2 class="section-heading">Research Projects</h2>
  <div class="repo-list">
    {
      research.map((r) => (
        <div class="repo-item">
          <h3>
            <a href={r.href} target="_blank" rel="noopener">
              {r.name}
            </a>
          </h3>
          <p>{r.desc}</p>
        </div>
      ))
    }
  </div>

  <h2 class="section-heading">Development Projects</h2>
  <div class="repo-list">
    {
      development.map((r) => (
        <div class="repo-item">
          <h3>
            <a href={r.href} target="_blank" rel="noopener">
              {r.name}
            </a>
            {r.demo && (
              <span class="repo-demo">
                [
                <a href={r.demo} target="_blank" rel="noopener">
                  Demo
                </a>
                ]
              </span>
            )}
          </h3>
          <p>{r.desc}</p>
        </div>
      ))
    }
  </div>

  <h2 class="section-heading">Academic Coursework &amp; Materials</h2>
  <div class="repo-list">
    {
      coursework.map((r) => (
        <div class="repo-item">
          <h3>
            <a href={r.href} target="_blank" rel="noopener">
              {r.name}
            </a>
          </h3>
          <p>{r.desc}</p>
        </div>
      ))
    }
  </div>
</BaseLayout>

<style>
  .repo-list {
    margin-bottom: 1rem;
  }
  .repo-item {
    padding: 1rem 0;
    border-bottom: 1px solid var(--divider);
  }
  .repo-item:last-child {
    border-bottom: none;
  }
  .repo-item h3 {
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0 0 0.4rem;
  }
  .repo-item h3 a {
    color: var(--link);
  }
  .repo-demo {
    font-size: 0.85rem;
    font-weight: 400;
    margin-left: 0.4rem;
    color: var(--text-muted);
  }
  .repo-demo a {
    color: #d73a49;
  }
  .repo-item p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.6;
  }
</style>
